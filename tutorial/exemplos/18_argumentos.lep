// O que vem depois do .lep na linha de comando.
//   expressa tutorial/exemplos/18_argumentos.lep Ana 16
// Na Aula: caixa "argumentos" em cima.

se argumentos.tamanho() == 0 {
    escreva("passe um nome: expressa tutorial/exemplos/18_argumentos.lep Ana")
} senão {
    escreva("olá, " + argumentos[1])
    se argumentos.tamanho() >= 2 {
        escreva("idade: " + argumentos[2])
    }
}
