+        assert_eq!(r.pos, w.bytes.len());
+        let mut out = Writer {
+            bytes: vec![],
+            items: MAX_ITEMS,
+        };
+        out.op(decoded).unwrap();
+        assert_eq!(out.bytes, w.bytes);
+    }
+    let mut r = Reader::new(&[255]);
+    assert!(r.op().is_err());
+}
