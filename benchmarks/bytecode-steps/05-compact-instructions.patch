+//! Private in-memory encoding. This is not a serialized file ABI.
+use super::*;
+
+const INLINE_MAX: u32 = 0x00ff_ffff;
+const WIDE: u8 = 0x80;
+
+#[derive(Clone, Copy)]
+pub(super) struct CallSite {
+    argc: u32,
+    name: u32,
+}
+
+impl Chunk {
+    /// Eight opcode bits and 24 inline operand bits. Rare larger operands keep
+    /// their full u32 value out of line, keyed by instruction ordinal.
+    pub(super) fn encode_op(&mut self, index: u32, op: Op) -> u32 {
+        let (tag, operand): (u8, u32) = match op {
+            Op::Nada => (0, 0),
+            Op::Drop => (1, 0),
+            Op::SetLast => (2, 0),
+            Op::Pair => (3, 0),
+            Op::Index => (4, 0),
+            Op::Index2 => (5, 0),
+            Op::Return => (6, 0),
+            Op::Finish => (7, 0),
+            Op::Checkpoint => (8, 0),
+            Op::EnterScope => (9, 0),
+            Op::LeaveScope => (10, 0),
+            Op::ParentScope => (11, 0),
+            Op::RestoreScope => (12, 0),
+            Op::CheckBool => (13, 0),
+            Op::CheckInt => (14, 0),
+            Op::EndTry => (15, 0),
+            Op::LoopBody => (16, 0),
+            Op::LoopEnd => (17, 0),
+            Op::Break => (18, 0),
+            Op::Continue => (19, 0),
+            Op::ReceiverIndex => (20, 0),
+            Op::ReceiverIndex2 => (21, 0),
+            Op::MatrixDestination => (22, 0),
+            Op::ReadDestination => (23, 0),
+            Op::WriteDestination => (24, 0),
+            Op::Constant(value) => (25, value),
+            Op::BadNumber(value) => (26, value),
+            Op::Load(value) => (27, value),
+            Op::Store(value) => (28, value),
+            Op::LoadLocal(value) => (29, value),
+            Op::StoreLocal(value) => (30, value),
+            Op::List(value) => (31, value),
+            Op::Field(value) => (32, value),
+            Op::MapField(value) => (33, value),
+            Op::Closure(value) => (34, value),
+            Op::Jump(value) => (35, value),
+            Op::BranchFalse(value) => (36, value),
+            Op::Try(value) => (37, value),
+            Op::Import(value) => (38, value),
+            Op::LoopEnter(value) => (39, value),
+            Op::LoopNext(value) => (40, value),
+            Op::NameDestination(value) => (41, value),
+            Op::ReceiverName(value) => (42, value),
+            Op::ReceiverMap(value) => (43, value),
+            Op::MapDestination(value) => (44, value),
+            Op::Bool(false) => (45, 0),
+            Op::Bool(true) => (46, 0),
+            Op::Slice(false) => (47, 0),
+            Op::Slice(true) => (48, 0),
+            Op::ReceiverReadOnly(false) => (49, 0),
+            Op::ReceiverReadOnly(true) => (50, 0),
+            Op::IndexDestination(false) => (51, 0),
+            Op::IndexDestination(true) => (52, 0),
+            Op::Unary(UnaryOp::Neg) => (53, 0),
+            Op::Unary(UnaryOp::Not) => (54, 0),
+            Op::Binary(BinaryOp::Add) => (55, 0),
+            Op::Binary(BinaryOp::Sub) => (56, 0),
+            Op::Binary(BinaryOp::Mul) => (57, 0),
+            Op::Binary(BinaryOp::Div) => (58, 0),
+            Op::Binary(BinaryOp::Rem) => (59, 0),
+            Op::Binary(BinaryOp::Eq) => (60, 0),
+            Op::Binary(BinaryOp::Ne) => (61, 0),
+            Op::Binary(BinaryOp::Lt) => (62, 0),
+            Op::Binary(BinaryOp::Le) => (63, 0),
+            Op::Binary(BinaryOp::Gt) => (64, 0),
+            Op::Binary(BinaryOp::Ge) => (65, 0),
+            Op::Binary(BinaryOp::And) => (66, 0),
+            Op::Binary(BinaryOp::Or) => (67, 0),
+            Op::Binary(BinaryOp::Contem) => (68, 0),
+            Op::ShortCircuit {
+                target,
+                value: false,
+            } => (69, target),
+            Op::ShortCircuit {
+                target,
+                value: true,
+            } => (70, target),
+            Op::Call { argc, name } => (71, {
+                let id = self.call_sites.len() as u32;
+                self.call_sites.push(CallSite { argc, name });
+                id
+            }),
+        };
+        if operand > INLINE_MAX {
+            self.wide_operands
+                .get_or_insert_with(Default::default)
+                .insert(index, operand);
+            (u32::from(tag | WIDE)) << 24
+        } else {
+            if let Some(wide) = &mut self.wide_operands {
+                wide.remove(&index);
+                if wide.is_empty() {
+                    self.wide_operands = None;
+                }
+            }
+            (u32::from(tag) << 24) | operand
+        }
+    }
+
+    #[inline(always)]
+    pub(super) fn op_at(&self, index: usize) -> Op {
+        let word = self.instructions[index].encoded;
+        let tag = (word >> 24) as u8;
+        let operand = if tag & WIDE != 0 {
+            self.wide_operands.as_ref().expect("wide operands")[&(index as u32)]
+        } else {
+            word & INLINE_MAX
+        };
+        match tag & !WIDE {
+            0 => Op::Nada,
+            1 => Op::Drop,
+            2 => Op::SetLast,
+            3 => Op::Pair,
+            4 => Op::Index,
+            5 => Op::Index2,
+            6 => Op::Return,
+            7 => Op::Finish,
+            8 => Op::Checkpoint,
+            9 => Op::EnterScope,
+            10 => Op::LeaveScope,
+            11 => Op::ParentScope,
+            12 => Op::RestoreScope,
+            13 => Op::CheckBool,
+            14 => Op::CheckInt,
+            15 => Op::EndTry,
+            16 => Op::LoopBody,
+            17 => Op::LoopEnd,
+            18 => Op::Break,
+            19 => Op::Continue,
+            20 => Op::ReceiverIndex,
+            21 => Op::ReceiverIndex2,
+            22 => Op::MatrixDestination,
+            23 => Op::ReadDestination,
+            24 => Op::WriteDestination,
+            25 => Op::Constant(operand),
+            26 => Op::BadNumber(operand),
+            27 => Op::Load(operand),
+            28 => Op::Store(operand),
+            29 => Op::LoadLocal(operand),
+            30 => Op::StoreLocal(operand),
+            31 => Op::List(operand),
+            32 => Op::Field(operand),
+            33 => Op::MapField(operand),
+            34 => Op::Closure(operand),
+            35 => Op::Jump(operand),
+            36 => Op::BranchFalse(operand),
+            37 => Op::Try(operand),
+            38 => Op::Import(operand),
+            39 => Op::LoopEnter(operand),
+            40 => Op::LoopNext(operand),
+            41 => Op::NameDestination(operand),
+            42 => Op::ReceiverName(operand),
+            43 => Op::ReceiverMap(operand),
+            44 => Op::MapDestination(operand),
+            45 => Op::Bool(false),
+            46 => Op::Bool(true),
+            47 => Op::Slice(false),
+            48 => Op::Slice(true),
+            49 => Op::ReceiverReadOnly(false),
+            50 => Op::ReceiverReadOnly(true),
+            51 => Op::IndexDestination(false),
+            52 => Op::IndexDestination(true),
+            53 => Op::Unary(UnaryOp::Neg),
+            54 => Op::Unary(UnaryOp::Not),
+            55 => Op::Binary(BinaryOp::Add),
+            56 => Op::Binary(BinaryOp::Sub),
+            57 => Op::Binary(BinaryOp::Mul),
+            58 => Op::Binary(BinaryOp::Div),
+            59 => Op::Binary(BinaryOp::Rem),
+            60 => Op::Binary(BinaryOp::Eq),
+            61 => Op::Binary(BinaryOp::Ne),
+            62 => Op::Binary(BinaryOp::Lt),
+            63 => Op::Binary(BinaryOp::Le),
+            64 => Op::Binary(BinaryOp::Gt),
+            65 => Op::Binary(BinaryOp::Ge),
+            66 => Op::Binary(BinaryOp::And),
+            67 => Op::Binary(BinaryOp::Or),
+            68 => Op::Binary(BinaryOp::Contem),
+            69 => Op::ShortCircuit {
+                target: operand,
+                value: false,
+            },
+            70 => Op::ShortCircuit {
+                target: operand,
+                value: true,
+            },
+            71 => {
+                let site = self.call_sites[operand as usize];
+                Op::Call {
+                    argc: site.argc,
+                    name: site.name,
+                }
+            }
+            _ => unreachable!("compiler opcode"),
+        }
+    }
+}
