+    // Exact field types from the preserved pre-encoding layout. These are size
+    // accounting types, never instantiated or retained by production code.
+    #[allow(dead_code)]
+    struct LegacyInstruction {
+        op: Op,
+        span: u32,
+    }
+    #[allow(dead_code)]
+    struct LegacyChunk {
+        parameter_slots: Rc<HashMap<String, u32>>,
+        instructions: Vec<LegacyInstruction>,
+        spans: Vec<Span>,
+        names: Vec<String>,
+        constants: Vec<Value>,
+        functions: Vec<Prototype>,
+        imports: Vec<Import>,
+        loops: Vec<LoopSpec>,
+    }
+    #[derive(Default)]
+    struct Storage {
+        instructions: usize,
+        chunks: usize,
+        calls: usize,
+        wide: usize,
+        old_bytes: usize,
+        new_bytes: usize,
+        old_capacity: usize,
+        new_capacity: usize,
+    }
+    fn storage(code: &Chunk, stats: &mut Storage) {
+        use std::mem::size_of;
+        // Rebuild the predecessor's instruction vector with the same push
+        // sequence, measuring its actual capacity rather than assuming the
+        // allocator growth policy is identical for both element sizes.
+        let mut legacy = Vec::new();
+        for (index, instruction) in code.instructions.iter().enumerate() {
+            legacy.push(LegacyInstruction {
+                op: code.op_at(index),
+                span: instruction.span,
+            });
+        }
+        stats.instructions += code.instructions.len();
+        stats.chunks += 1;
+        stats.calls += code.call_sites.len();
+        stats.wide += code.wide_operands.as_ref().map_or(0, |m| m.len());
+        stats.old_bytes += code.instructions.len() * size_of::<LegacyInstruction>();
+        stats.new_bytes += code.instructions.len() * size_of::<Instruction>()
+            + code.call_sites.len() * size_of::<CallSite>();
+        stats.old_capacity +=
+            legacy.capacity() * size_of::<LegacyInstruction>() + size_of::<LegacyChunk>();
+        stats.new_capacity += code.instructions.capacity() * size_of::<Instruction>()
+            + code.call_sites.capacity() * size_of::<CallSite>()
+            + size_of::<Chunk>();
+        for function in &code.functions {
+            storage(&function.code, stats);
+        }
+    }
+    #[test]
+    fn compiled_workload_storage_report() {
+        use std::fmt::Write;
+        let mut paths: Vec<_> =
+            std::fs::read_dir(concat!(env!("CARGO_MANIFEST_DIR"), "/benchmarks/programs"))
+                .unwrap()
+                .map(|e| e.unwrap().path())
+                .filter(|p| p.extension().is_some_and(|e| e == "lep"))
+                .collect();
+        paths.sort();
+        let mut report = String::from(
+            "program,instructions,chunks,calls,wide,legacy_instruction_bytes,compact_instruction_bytes,legacy_used_bytes,compact_used_bytes,legacy_capacity_and_headers_bytes,compact_capacity_and_headers_bytes\n",
+        );
+        for path in paths {
+            let program = parse(&std::fs::read_to_string(&path).unwrap()).unwrap();
+            let code = compiler::module(&program.items);
+            let mut stats = Storage::default();
+            storage(&code, &mut stats);
+            assert_eq!(
+                stats.wide, 0,
+                "report excludes allocator bucket sizes for exceptional operands"
+            );
+            writeln!(
+                &mut report,
+                "{},{},{},{},{},{},{},{},{},{},{}",
+                path.file_stem().unwrap().to_str().unwrap(),
+                stats.instructions,
+                stats.chunks,
+                stats.calls,
+                stats.wide,
+                std::mem::size_of::<LegacyInstruction>(),
+                std::mem::size_of::<Instruction>(),
+                stats.old_bytes,
+                stats.new_bytes,
+                stats.old_capacity,
+                stats.new_capacity
+            )
+            .unwrap();
+        }
+        if let Some(path) = std::env::var_os("EXPRESSA_CODE_SIZE_CSV") {
+            std::fs::write(path, report).unwrap();
+        }
+    }
+}
