+    #[test]
+    fn wide_operands_and_backpatching_preserve_full_u32_range() {
+        let mut code = empty_code();
+        for value in [0, INLINE_MAX, INLINE_MAX + 1, u32::MAX] {
+            for op in [
+                Op::Constant(value),
+                Op::LoadLocal(value),
