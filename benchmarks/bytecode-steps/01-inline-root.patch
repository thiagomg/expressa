+// Every frame has one initial scope. Keep it inline so calls without nested
+// blocks do not allocate a separate scope vector.
+struct Scopes {
+    root: Option<Rc<RefCell<Env>>>,
+    nested: Vec<Rc<RefCell<Env>>>,
+}
+impl Scopes {
+    fn new(root: Rc<RefCell<Env>>) -> Self {
+        Self {
+            root: Some(root),
+            nested: vec![],
+        }
+    }
+    fn last(&self) -> Option<&Rc<RefCell<Env>>> {
+        self.nested.last().or(self.root.as_ref())
+    }
+    fn len(&self) -> usize {
+        usize::from(self.root.is_some()) + self.nested.len()
+    }
+    fn push(&mut self, env: Rc<RefCell<Env>>) {
+        self.nested.push(env);
+    }
+    fn pop(&mut self) -> Option<Rc<RefCell<Env>>> {
+        self.nested.pop().or_else(|| self.root.take())
+    }
+}
 struct Frame {
