    </context>
    <context id="expressa" class="no-spell-check">
      <include>
        <context ref="shebang"/>
        <context ref="doc-comment"/>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="string"/>
        <context ref="key-ident"/>
        <context ref="number"/>
        <context ref="boolean"/>
        <context ref="keyword"/>
        <context ref="builtin"/>
      </include>
    </context>
  </definitions>
</language>
