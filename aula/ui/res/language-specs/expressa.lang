<?xml version="1.0" encoding="UTF-8"?>
<language id="expressa" _name="Expressa" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-expressa</property>
    <property name="globs">*.lep</property>
    <property name="line-comment-start">//</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>
  <styles>
    <style id="comment" _name="Comment" map-to="def:comment"/>
    <style id="doc-comment" _name="Documentation" map-to="def:comment"/>
    <style id="string" _name="String" map-to="def:string"/>
    <style id="escape" _name="Escape" map-to="def:special-char"/>
    <style id="keyword" _name="Keyword" map-to="def:keyword"/>
    <style id="boolean" _name="Boolean" map-to="def:boolean"/>
    <style id="number" _name="Number" map-to="def:decimal"/>
    <style id="builtin" _name="Built-in" map-to="def:function"/>
  </styles>
  <definitions>
    <context id="shebang" style-ref="comment" end-at-line-end="true">
      <start>^#!</start>
    </context>
    <context id="doc-comment" style-ref="doc-comment" end-at-line-end="true">
      <start>///([^/]|$)</start>
    </context>
    <context id="line-comment" style-ref="comment" end-at-line-end="true">
      <start>//</start>
    </context>
    <context id="block-comment" style-ref="comment">
      <start>/\*</start>
      <end>\*/</end>
    </context>
    <context id="string" style-ref="string">
      <start>"</start>
      <end>"</end>
      <include>
        <context id="escape" style-ref="escape">
          <match>\\["\\nrt]</match>
        </context>
      </include>
    </context>
    <context id="key-ident" style-ref="string">
      <match>:[A-Za-zÀ-ÿ_][A-Za-zÀ-ÿ0-9_]*</match>
    </context>
    <context id="number" style-ref="number">
      <match>\b[0-9][0-9_]*(\.[0-9_]+)?\b</match>
    </context>
    <context id="boolean" style-ref="boolean">
      <prefix>\b</prefix>
      <suffix>\b</suffix>
      <keyword>verdadeiro</keyword>
      <keyword>falso</keyword>
    </context>
    <context id="keyword" style-ref="keyword">
      <prefix>\b</prefix>
      <suffix>\b</suffix>
      <keyword>se_falhar</keyword>
      <keyword>retorne</keyword>
      <keyword>pare</keyword>
      <keyword>continue</keyword>
      <keyword>continua</keyword>
      <keyword>se</keyword>
      <keyword>senao</keyword>
      <keyword>ou</keyword>
      <keyword>e</keyword>
      <keyword>nao</keyword>
      <keyword>inicio</keyword>
      <keyword>fim</keyword>
      <keyword>funcao</keyword>
      <keyword>para</keyword>
      <keyword>de</keyword>
      <keyword>ate</keyword>
      <keyword>em</keyword>
      <keyword>repita</keyword>
      <keyword>enquanto</keyword>
      <keyword>vezes</keyword>
      <keyword>importe</keyword>
      <keyword>contem</keyword>
    </context>
    <context id="builtin" style-ref="builtin">
      <prefix>\b</prefix>
      <suffix>\b</suffix>
      <keyword>escreva</keyword>
      <keyword>escreva_erro</keyword>
      <keyword>sair</keyword>
      <keyword>cls</keyword>
      <keyword>limpe_tela</keyword>
      <keyword>casa</keyword>
      <keyword>pinte</keyword>
      <keyword>fundo</keyword>
      <keyword>negrito</keyword>
      <keyword>durma</keyword>
      <keyword>leia</keyword>
      <keyword>leia_linhas</keyword>
      <keyword>eh_terminal</keyword>
      <keyword>é_terminal</keyword>
      <keyword>argumentos</keyword>
      <keyword>numero</keyword>
      <keyword>número</keyword>
      <keyword>formato</keyword>
      <keyword>formate</keyword>
      <keyword>avaliar</keyword>
      <keyword>catalogo</keyword>
      <keyword>ajuda</keyword>
      <keyword>catálogo</keyword>
      <keyword>mapa</keyword>
      <keyword>conjunto</keyword>
      <keyword>matriz</keyword>
      <keyword>raiz</keyword>
      <keyword>aleatorio</keyword>
      <keyword>aleatório</keyword>
      <keyword>semente</keyword>
      <keyword>pi</keyword>
      <keyword>seno</keyword>
      <keyword>sen</keyword>
      <keyword>cosseno</keyword>
