/// Segure as setas para mover. Shift acelera; espaço troca a cor. Esc sai.
tela_grafica = importe "tela_grafica"
g = tela_grafica::nova(160, 144, 4)
x = 76
y = 68
azul = verdadeiro
g.tela_grafica::mostre()

enquanto verdadeiro {
    ev = g.tela_grafica::evento()
    se ev:sair ou ev:apertadas contem :escape { pare }
    passo = se ev:teclas contem :shift { 3 } senao { 1 }
    se ev:teclas contem :esquerda { x -= passo }
    se ev:teclas contem :direita { x += passo }
    se ev:teclas contem :cima { y -= passo }
    se ev:teclas contem :baixo { y += passo }
    se ev:apertadas contem :espaco { azul = nao azul }
    se x < 0 { x = 0 }
    se x > 151 { x = 151 }
    se y < 0 { y = 0 }
    se y > 135 { y = 135 }
    g.tela_grafica::apague()
    g.tela_grafica::cor(se azul { :azul } senao { :vermelho })
    g.tela_grafica::retangulo(x, y, x + 8, y + 8)
    g.tela_grafica::mostre()
    durma(0.02)
}
