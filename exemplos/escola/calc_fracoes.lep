fracao = importe "../lib/fracao"
importe "tela"

soma_e_escreva = função(fr1, fr2) {
    res = fracao::soma(fr1, fr2)
    escreva(formate("{} + {} = {}", fracao::em_texto(fr1), fracao::em_texto(fr2), fracao::em_texto(res)))
}

txt_como_fracao = funcao(txt) {
    itens = txt.separe("/")
    para i em 0..itens.tamanho() {
        t = itens[i]
        n = numero(t) se_falhar { falso }
        se n == falso {
            falhe("Não foi possível ler esta fração ou número: " + txt)
        }
        itens[i] = n
    }
    
    n = itens[0]
    d = se itens.tamanho() == 1 {
        1
    } ou se itens.tamanho() == 2 {
        itens[1]
    } senão {
        falhe("Use uma fração como 1/2 ou um número inteiro, como 2.")
    }
    
    se d == 0 {
        falhe("O número de baixo (denominador) não pode ser zero.")
    }
    
    fracao::nova(n, d)
}

leia_opcao = funcao(txt) {
    res = falso
    enquanto res == falso {
        pos = posicao_cursor()
        fr1_txt = leia(txt)
        res = txt_como_fracao(fr1_txt) se_falhar erro {
            escreva("Erro: ".pinte(:vermelho) + erro)
            posicao_cursor(pos)
            apague_linha()
            falso
        }
    }
    res
}

escreva("Calculando frações")
escreva("------------------")

escreva("Digite uma fração, como 1/2 ou 3/4, ou um número inteiro, como 2.")
fr1 = leia_opcao("Digite a primeira fração para calcular: ")
fr2 = leia_opcao("Digite a segunda fração para calcular: ")
soma_e_escreva(fr1, fr2)

