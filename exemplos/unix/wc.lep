#!/usr/bin/env expressa

importe "arquivo"
importe "lib/linha_cmd"

é_alfanumerico = função(c) {
    c = sem_acento(c)
    se (c >= "A" e c <= "Z") ou (c >= "a" e c <= "z") ou (c >= "0" e c <= "9") {
        verdadeiro
    } senao {
        falso
    }
}

conta_palavras = função(frase) {
    palavras = 0
    i = 0
    enquanto i < frase.tamanho() {
        // Procura a próxima letra ou número.
        enquanto i < frase.tamanho() {
            c = frase[i]
            se é_alfanumerico(c) { pare }
            i = i + 1
        }

        // Avança até o fim da sequência de letras e números.
        encontrou = falso
        enquanto i < frase.tamanho() {
            c = frase[i]
            se é_alfanumerico(c) == falso { pare }
            // Encontrou pelo menos uma letra ou número.
            encontrou = verdadeiro
            i = i + 1
        }

        se encontrou == verdadeiro {
            palavras = palavras + 1
        }
    
    }
    palavras
}

palavras_em_linhas = função(linhas) {
    num = 0
    para linha em linhas
    {
        num = num + conta_palavras(linha)
    }
    num
}

conta_linhas = função(linhas)
{
    num = 0
    para linha em linhas
    {
        num = num + 1
    }
    num
}

ajuda = função()
{
    escreva("Para ler texto enviado por outro comando (entrada padrão):")
    escreva("cat meu-arq.txt | wc.lep [-l]")
    escreva("")
    escreva("Para ler um ou mais arquivos:")
    escreva("wc.lep [-l] meu-arq.txt meu-arq-2.txt ...")
    escreva("-l conta linhas; sem essa opção, conta palavras (sequências de letras e números).")
}

exec_wc = função(args)
{
    função_contagem = se args:op contém "l" {
        conta_linhas
    } senao {
        palavras_em_linhas
    }

    se args:pos.tamanho() == 0
    {
        // Sem nomes de arquivos, lê o texto da entrada padrão.
        linhas = leia_linhas()
        total = função_contagem(linhas)
        escreva(total)
    }
    senao
    {
        // Conta cada arquivo informado e acumula o total.
        total_geral = 0
        para i em 0..args:pos.tamanho()
        {
            arg = args:pos[i]
            total = função_contagem(leia_arquivo(arg))
            escreva(arg, "=", total)
            total_geral = total_geral + total
        }
        escreva("Total geral:", total_geral)
    }
}

// Programa principal
args = separa_args(argumentos, [])
se args:op contem "ajuda" {
    ajuda()
} senao {
    exec_wc(args)
}

