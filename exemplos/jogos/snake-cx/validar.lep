// Execute: expressa exemplos/jogos/snake-cx/validar.lep
regras = importe "regras"
controles = importe "controles"
desenho = importe "desenho"
grafica = importe "tela_grafica"
mat = importe "mat"
relatorio = mapa([:verificacoes -> 0])

confira = funcao(condicao, descricao) {
    se nao condicao { falhe(descricao) }
    relatorio:verificacoes += 1
}

entrada = funcao(apertadas, acontecimentos) {
    mapa([:teclas -> conjunto(), :apertadas -> conjunto(apertadas),
        :soltas -> conjunto(), :eventos -> acontecimentos, :sair -> falso])
}

comida_livre = funcao(estado) {
    para parte em estado:corpo {
        confira(parte != estado:comida, "A comida não pode nascer dentro do corpo")
    }
}

mat::semente(2026)
estado = regras::novo()
confira(tamanho(estado:corpo) == 3, "A partida deve começar com três células")
antes = clone(estado)
regras::avance_tempo(estado, 10)
confira(estado == antes, "A partida deve esperar a primeira direção")
para rodada em 0..20 {
    regras::sorteie_comida(estado)
    comida_livre(estado)
}

confira(nao regras::solicite_direcao(estado, [-1, 0]), "Não deve aceitar uma inversão de 180 graus")
confira(nao estado:iniciou, "Uma direção recusada não deve iniciar a partida")
confira(nao regras::solicite_direcao(estado, [1, 1]), "Não deve aceitar direções diagonais")
confira(regras::solicite_direcao(estado, [0, -1]), "Deve aceitar a primeira curva")
confira(regras::solicite_direcao(estado, [-1, 0]), "Deve guardar uma segunda curva")
confira(nao regras::solicite_direcao(estado, [1, 0]), "A oposição deve ser comparada com a última curva pendente")
confira(nao regras::solicite_direcao(estado, [0, 1]), "A fila deve limitar a duas curvas")
estado:comida = [0, 0]
cabeca = clone(estado:corpo[0])
regras::passo(estado)
confira(estado:corpo[0] == [cabeca[0], cabeca[1] - 1], "A primeira curva deve ser aplicada em um passo")
regras::passo(estado)
confira(estado:corpo[0] == [cabeca[0] - 1, cabeca[1] - 1], "A segunda curva precisa esperar o próximo passo")

estado = regras::crie(8, 6)
estado:iniciou = verdadeiro
estado:comida = [5, 3]
regras::passo(estado)
confira(tamanho(estado:corpo) == 4 e estado:pontos == 10, "Comer deve crescer e pontuar")
confira(estado:frutas == 1, "Uma fruta deve ser contada uma única vez")
comida_livre(estado)
estado:frutas = 4
estado:comida = [6, 3]
regras::passo(estado)
confira(estado:nivel == 2, "Cinco frutas devem aumentar o nível")
confira(regras::intervalo(estado) < 0.16, "A velocidade deve aumentar")
estado:nivel = 100
confira(regras::intervalo(estado) == 0.07, "A velocidade deve respeitar o período mínimo")

// Entrar na cauda é permitido quando ela sai no mesmo passo.
estado = regras::crie(5, 5)
estado:iniciou = verdadeiro
estado:corpo = [[1, 1], [1, 2], [2, 2], [2, 1]]
estado:direcao = [1, 0]
estado:comida = [4, 4]
regras::passo(estado)
confira(nao estado:terminou e estado:corpo[0] == [2, 1], "A cauda que sai não deve bloquear a cabeça")
confira(tamanho(estado:corpo) == 4, "Mover sem comer deve preservar o tamanho")

estado = regras::crie(5, 5)
estado:iniciou = verdadeiro
estado:corpo = [[2, 2], [2, 3], [1, 3], [1, 2], [1, 1], [2, 1], [3, 1], [3, 2]]
estado:direcao = [0, -1]
estado:comida = [4, 4]
antes = clone(estado:corpo)
regras::passo(estado)
confira(estado:terminou e nao estado:venceu, "Colidir com o corpo deve encerrar a partida")
confira(estado:corpo == antes, "Uma colisão não deve gravar uma cabeça inválida")

para caso em [[[0, 2], [-1, 0]], [[4, 2], [1, 0]], [[2, 0], [0, -1]], [[2, 4], [0, 1]]] {
    estado = regras::crie(5, 5)
    estado:iniciou = verdadeiro
    estado:corpo = [caso[0]]
    estado:direcao = caso[1]
    antes = clone(estado:corpo)
    regras::passo(estado)
    confira(estado:terminou e estado:corpo == antes, "Todas as bordas devem impedir a passagem")
}

// Um corpo contínuo ocupa todo o tabuleiro, exceto a próxima célula da cabeça.
estado = regras::crie(5, 5)
estado:corpo = []
para y em 0..5 {
    para coluna em 0..5 {
        x = se y % 2 == 0 { coluna } senao { 4 - coluna }
        se nao (x == 0 e y == 0) { estado:corpo += [[x, y]] }
    }
}
regras::sorteie_comida(estado)
confira(estado:comida == [0, 0], "O único espaço livre deve receber a comida")
estado:iniciou = verdadeiro
estado:direcao = [-1, 0]
regras::passo(estado)
confira(estado:venceu e estado:terminou e estado:comida == nada, "O tabuleiro cheio deve encerrar com vitória")
confira(tamanho(estado:corpo) == 25, "A vitória deve preencher as 25 células")
antes = clone(estado)
regras::passo(estado)
confira(estado == antes, "Uma partida encerrada não pode continuar andando")

para frequencia em [30, 60] {
    estado = regras::novo()
    regras::solicite_direcao(estado, [1, 0])
    estado:comida = [0, 0]
    inicial = clone(estado:corpo[0])
    para quadro em 0..frequencia { regras::avance_tempo(estado, 1 / frequencia) }
    confira(estado:corpo[0] == [inicial[0] + 6, inicial[1]], "A velocidade não deve depender da frequência de desenho")
}

estado = regras::novo()
estado:comida = [0, 0]
cabeca = clone(estado:corpo[0])
eventos = [mapa([:tipo -> :tecla, :tecla -> :w]), mapa([:tipo -> :tecla, :tecla -> :a])]
controles::atualize(estado, entrada([:w, :a], eventos), 0)
confira(estado:pendentes == [[0, -1], [-1, 0]], "A entrada deve preservar a ordem dos acontecimentos")
controles::atualize(estado, entrada([], []), 0.16)
confira(estado:corpo[0] == [cabeca[0], cabeca[1] - 1], "W deve virar para cima")
controles::atualize(estado, entrada([], []), 0.16)
confira(estado:corpo[0] == [cabeca[0] - 1, cabeca[1] - 1], "A deve virar para a esquerda no passo seguinte")
controles::atualize(estado, entrada([:p], []), 0)
antes = clone(estado)
controles::atualize(estado, entrada([:s], []), 10)
confira(estado == antes, "A pausa deve congelar curvas, movimento e relógio")
controles::atualize(estado, entrada([:p], []), 0)
controles::atualize(estado, entrada([], [mapa([:tipo -> :desfoco])]), 0)
confira(estado:pausado e estado:pendentes == [], "Perder foco deve pausar e limpar curvas pendentes")
controles::atualize(estado, entrada([:r], []), 0)
confira(nao estado:iniciou e nao estado:pausado e estado:pontos == 0, "R deve voltar à espera inicial")
cabeca = clone(estado:corpo[0])
estado:comida = [0, 0]
controles::atualize(estado, entrada([:direita], []), 100)
confira(estado:corpo[0] == [cabeca[0] + 1, cabeca[1]], "Um atraso grande deve ser limitado a 0,25 segundo")

tela = desenho::nova_tela(estado)
antes = clone(estado)
desenho::quadro(tela, estado)
confira(estado == antes, "Desenhar não deve alterar a partida")
confira(tela.grafica::pixel(0, 0) == :preto, "O desenho deve poder ser rasterizado sem janela")
escreva("Cobrinha: ", relatorio:verificacoes, " verificações passaram, sem abrir janela.")
