inicial = funcao() {
    tentativas = []
    tentativas += ["OPCAO"]
    tentativas += ["CERTA"]
    tentativas += ["EEOOE"]
    tentativas += ["     "]
    tentativas += ["     "]

    desenha_tentativa("TERMO", tentativas)    
}

inicial()