importe "matriz"
importe "tela"
importe "mat"

// Cria um novo jogo aleatório
inicia_jogo = funcao(m) {
    para i de 0 até m.nlinhas() - 1 {
        para j de 0 até m.ncolunas() - 1 {
            m[i, j] = aleatorio(0, 1)
        }
    }
}

// Cria um novo jogo com um padrão pré definido
predefinido = função(m) {
    // planador
    m[1, 2] = 1
    m[2, 3] = 1
    m[3, 1] = 1
    m[3, 2] = 1
    m[3, 3] = 1

    // pisca-pisca
    m[7, 19] = 1
    m[7, 20] = 1
    m[7, 21] = 1
}

// Desenha o mundo definido pela matriz m
desenha = funcao(m) {
    espaço = " "
    ser = "*"
    // ser = "█"
    
    // borda to topo e executapé - +- linhas -+
    borda = "+"
    para i de 0 até m.ncolunas() - 1 {
        borda += "-"
    }    
    borda += "+"
    
    escreva(borda)
    para i de 0 até m.nlinhas() - 1 {
        l = "|"
        para j de 0 até m.ncolunas() - 1 {
            l += se m[i, j] == 0 { espaço } senao { ser }
        }
        l += "|"
        escreva(l)
    }
    escreva(borda)
}

pos_lin = função(m, l) {
    se l < 0 { m.nlinhas() - 1 }
    ou se l >= m.nlinhas() { 0 }
    senão { l }
}

pos_col = função(m, c) {
    se c < 0 { m.ncolunas() - 1 }
    ou se c >= m.ncolunas() { 0 }
    senão { c }
}


// Retorna uma matriz com a celula do meio e seus vizinhos
// Caso a celula esteja em qualquer borda, os vizinhos serão do outro lado
// já que tudo rotaciona como se fosse uma esfera
vizinhos = função(m, l, c) {

    v = zeros(3)

    // Noroeste
    v[0,0] = m[ m.pos_lin(l-1), m.pos_col(c-1) ]
    // Norte
    v[0,1] = m[ m.pos_lin(l-1), m.pos_col(c) ]
    // Nordeste
    v[0,2] = m[ m.pos_lin(l-1), m.pos_col(c+1) ]

    // Oeste
    v[1,0] = m[ m.pos_lin(l), m.pos_col(c-1) ]
    // Centro
    v[1,1] = m[l, c]
    // Leste
    v[1,2] = m[ m.pos_lin(l), m.pos_col(c+1) ]

    // Sudoeste
    v[2,0] = m[ m.pos_lin(l+1), m.pos_col(c-1) ]
    // Sul
    v[2,1] = m[ m.pos_lin(l+1), m.pos_col(c) ]
    // Sudeste
    v[2,2] = m[ m.pos_lin(l+1), m.pos_col(c+1) ]

    v
}

// Conta a quantidade de vizinhos numa matrix 3x3
// da celula na posição (1, 1)
conta_vizinhos = função(m) {
    se m.nlinhas() != 3 ou m.ncolunas() != 3 {
        escreva_erro("a função conta_vizinhos só aceita matrizes de 3x3")
        saia(1)
    }

    items = [
        m[0,0], m[0,1], m[0,2],
        m[1,0], m[1,2],
        m[2,0], m[2,1], m[2,2],
    ]

    total_vizinhos = 0
    para item em items {
        total_vizinhos += se item == 0 { 0 } senão { 1 }
    }
    total_vizinhos
}

// Executa uma nova geração do mundo e retorna em uma nova matriz
nova_geracao = função(m) {
    // Regras do jogo
    // Toda célula viva com menos de dois vizinhos vivos morre por isolamento.
    // Toda célula viva com mais de três vizinhos vivos morre por superpopulação.
    // Toda célula viva com dois ou três vizinhos vivos permanece viva.[3]
    // Toda célula morta com exatamente três vizinhos vivos torna-se viva (nascimento).

    // Salvando o total de linhas e colunas pois eu não quero escrever nlinhas/ncolunas
    // o tempo todo
    tl = m.nlinhas()
    tc = m.ncolunas()

    // Nos precisamos criar uma nova matriz pois todas as mudanças são simulatâneas.
    // Se eu mudar a matriz de origem, uma celula vai influenciar a outra
    nm = zeros(tl, tc)

    para i de 0 até m.nlinhas() - 1 {
        para j de 0 até m.ncolunas() - 1 {
            // Aqui vamos pegar os vizinhos de cada uma das celular da matriz de origem m
            v = m.vizinhos(i, j)
            // e vamos contas a quatidade de vizinhos para aplicar cada uma das regras
            num_v = v.conta_vizinhos()

            // 0 = morta, qualquer outro valor, viva
            cel_viva = m[i, j]

            nova_celula = se cel_viva != 0 {
                // A celula está viva
                se num_v < 2 {
                    0 // Toda célula viva com menos de dois vizinhos vivos morre por isolamento.
                } ou se num_v > 3 {
                    0 // Toda célula viva com mais de três vizinhos vivos morre por superpopulação.
                } senão { // Unica opção faltando - ou se num_v == 2 ou num_v == 3
                    1 // Toda célula viva com dois ou três vizinhos vivos permanece viva.[3]
                }
            } senão {
                // Celular está morta
                se num_v == 3 {
                    1 // Toda célula morta com exatamente três vizinhos vivos torna-se viva (nascimento).
                } senão {
                    0
                }
            }

            // E agora vamos atualizar a nova matriz
            nm[i, j] = nova_celula
        }
    }

    nm
}

// Rotina principal do jogo
m = zeros(15, 30)
m.inicia_jogo()
// m.predefinido()

cls()
desenha(m)
enquanto 1 == 1 {
    casa()
    m = m.nova_geracao()
    desenha(m)
    durma(0.2)
}
