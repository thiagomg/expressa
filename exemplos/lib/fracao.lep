// TODO: Implementar algo como to_string

mdc = funcao(x, y)
inicio
    se y == 0
    inicio
        x
    fim
    senao
    inicio
        mdc(y, x % y)
    fim
fim


mmc = funcao(x, y)
inicio
    x * y / mdc(x, y)
fim


nova = função(numerador, denominador)
inicio
    mapa([
        :numerador -> numerador,
        :denominador -> denominador,
    ])
fim

em_texto = função(fr)
inicio
    formate("{}/{}", fr:numerador, fr:denominador)
fim

em_fracao = função(n)
inicio
    se tipo(n) == "numero"
    inicio
        nova(n, 1)
    fim
    senão
    inicio
        n
    fim
fim

soma = função(fr1, fr2)
inicio
    fr1 = em_fracao(fr1)
    fr2 = em_fracao(fr2)
    
    se fr1:denominador == fr2:denominador
    inicio
        // Este é muito simples. Basta somar o numerador
        nova(fr1:numerador + fr2:numerador, fr1:denominador)
    fim
    senão
    inicio
        // Precisamos calcular o MMC do denominador primeiro
        novo_den = mmc(fr1:denominador, fr2:denominador)
        // E agora dividir por cada denominador e multiplicar pelo numerador
        novo_num = função(valor_mmc, num, den)
        inicio
            (valor_mmc / den) * num
        fim
        num1 = novo_num(novo_den, fr1:numerador, fr1:denominador)
        num2 = novo_num(novo_den, fr2:numerador, fr2:denominador)
        escreva(formate("- 1: {}/{}, 2: {}/{}", num1, novo_den, num2, novo_den))
        
        resultado = nova(num1 + num2, novo_den)
        
        // TODO: Adicionar simplificar fração
        
        resultado
    fim
fim

simplifica = função()
inicio
    
fim

