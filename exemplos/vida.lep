importe "matriz"
importe "tela"

// Jogo da Vida de Conway no terminal.
// Cada geração: monta o quadro em texto, casa(), escreva, durma.
//
//   expressa examples/vida.lep
//
// Troque vivo/morto se o terminal não gostar de Unicode.

alt = 14
larg = 36
geracoes = 40
vivo = "█"
morto = " "

// 1-based, com wrap (o plano é um toro).
ciclo = funcao(i, n) {
    r = (i - 1) % n
    se r < 0 { r = r + n }
    r + 1
}

vizinhos = funcao(g, i, j) {
    n = 0
    para di de -1 ate 1 {
        para dj de -1 ate 1 {
            se di != 0 ou dj != 0 {
                ni = ciclo(i + di, alt)
                nj = ciclo(j + dj, larg)
                n += g[ni, nj]
            }
        }
    }
    n
}

passo = funcao(g) {
    prox = zeros(alt, larg)
    para i de 1 ate alt {
        para j de 1 ate larg {
            v = vizinhos(g, i, j)
            cel = g[i, j]
            prox[i, j] = se cel == 1 {
                se v == 2 ou v == 3 { 1 } senao { 0 }
            } senao {
                se v == 3 { 1 } senao { 0 }
            }
        }
    }
    prox
}

desenhe = funcao(g) {
    quadro = ""
    para i de 1 ate alt {
        linha = ""
        para j de 1 ate larg {
            linha += se g[i, j] == 1 { vivo } senao { morto }
        }
        quadro += linha
        se i < alt { quadro += "\n" }
    }
    casa()
    escreva(quadro)
}

mundo = zeros(alt, larg)

// planador
mundo[2, 3] = 1
mundo[3, 4] = 1
mundo[4, 2] = 1
mundo[4, 3] = 1
mundo[4, 4] = 1

// pisca-pisca
mundo[8, 20] = 1
mundo[8, 21] = 1
mundo[8, 22] = 1

cls()
para g de 1 ate geracoes {
    desenhe(mundo)
    mundo = passo(mundo)
    durma(0.12)
}
