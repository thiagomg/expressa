// Estatística descritiva: média, mediana, moda e amplitude.
// Mediana exige lista ordenada — usamos um bubble sort.
//
// Altere `dados` e rode: cargo run -- examples/estatistica.lep

dados = [7, 8, 5, 9, 7, 6, 8, 7, 10, 5]

ordena = funcao(lista)
inicio
    tam = tamanho(lista)
    copia = []
    para x em lista
    inicio
        copia = copia + [x]
    fim
    para i de 1 ate tam
    inicio
        para j de 1 ate tam - 1
        inicio
            se copia[j] > copia[j + 1]
            inicio
                tmp = copia[j]
                copia[j] = copia[j + 1]
                copia[j + 1] = tmp
            fim
        fim
    fim
    copia
fim

media = funcao(lista)
inicio
    acc = 0
    para x em lista
    inicio
        acc = acc + x
    fim
    acc / tamanho(lista)
fim

mediana = funcao(lista)
inicio
    ordenada = ordena(lista)
    tam = tamanho(ordenada)
    se tam % 2 == 1
    inicio
        ordenada[(tam + 1) / 2]
    fim
    senao
    inicio
        (ordenada[tam / 2] + ordenada[tam / 2 + 1]) / 2
    fim
fim

moda = funcao(lista)
inicio
    melhor = primeiro(lista)
    melhor_qtd = 0
    para candidato em lista
    inicio
        qtd = 0
        para x em lista
        inicio
            se x == candidato
            inicio
                qtd = qtd + 1
            fim
        fim
        se qtd > melhor_qtd
        inicio
            melhor = candidato
            melhor_qtd = qtd
        fim
    fim
    melhor
fim

ord = ordena(dados)
n = tamanho(dados)

escreva("dados:    " + dados)
escreva("ordenado: " + ord)
escreva("n:        " + n)
escreva("média:    " + media(dados))
escreva("mediana:  " + mediana(dados))
escreva("moda:     " + moda(dados) + " (aparece mais vezes)")
escreva("mínimo:   " + primeiro(ord))
escreva("máximo:   " + ultimo(ord))
escreva("amplitude: " + (ultimo(ord) - primeiro(ord)))
